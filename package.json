{
  "name": "vivian-desktop-pet",
  "version": "1.0.0",
  "private": true,
  "description": "薇薇安桌宠 — 基于 Electron 的桌面陪伴程序",
  "main": "./out/main/index.js",
  "author": "Vivian Desktop Pet contributors",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maixiaofanqie/ZZZ-Vivian-desktop-pet.git"
  },
  "homepage": "https://github.com/Maixiaofanqie/ZZZ-Vivian-desktop-pet",
  "bugs": {
    "url": "https://github.com/Maixiaofanqie/ZZZ-Vivian-desktop-pet/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "neutral-icons": "electron scripts/make-neutral-icons.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "docs:check": "node scripts/check-docs.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run docs:check && npm run check-assets",
    "package:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "windows",
    "zenless-zone-zero"
  ]
}
